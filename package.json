{
  "name": "block-workshop",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=2 --minWorkers=1",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run typecheck && npm run test:run && npm run build && npm run check:dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.0",
    "typescript": "5.9.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
